CLM_APP_WEB_URL_RU=http://127.0.0.1:3001
CLM_APP_WEB_URL_WORLD=http://127.0.0.1:3000
CLM_APP_SESSION_SECRET=<development-session-secret>
CLM_APP_REGISTRATION_PRIVATE_KEY=<development-registration-private-key>
CLM_APP_REGISTRATION_PUBLIC_KEY_RU=<development-ru-registration-public-key>
